---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Iris</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <link rel="stylesheet" href="/static/iris.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand mono" href="/plugins">iris</a>
      <nav id="account" class="account" aria-label="Account"></nav>
    </header>
    <main class="container">
      <slot />
    </main>
  </body>
</html>

<script>
  import { loadSession, onSession } from '../lib/session';
  import { el } from '../lib/api';

  const nav = document.getElementById('account')!;
  const link = (href: string, text: string, className = '') => {
    const a = el('a', className, text);
    a.setAttribute('href', href);
    return a;
  };

  onSession((user) => {
    nav.replaceChildren();
    if (!user) {
      nav.append(link('/accounts/login/', 'Sign in', 'btn btn-primary btn-sm'));
      return;
    }
    nav.append(
      link('/plugins', 'Plugins'),
      link('/subscriptions', 'Subscriptions'),
      el('span', 'account-email mono muted', user.email),
      link('/accounts/logout/', 'Sign out', 'btn btn-sm'),
    );
  });

  loadSession();
</script>
