---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Plugins">
  <div class="page-head">
    <h1>Plugins</h1>
    <a class="btn btn-primary" href="/plugins/new">New plugin</a>
  </div>
  <div class="box" id="plugins"><div class="empty">Loading…</div></div>
</Layout>

<script>
  import { api, el, type Page } from '../../lib/api';

  interface Plugin {
    id: string;
    name: string;
    desc: string;
    hint: string;
    prefix: string | null;
  }

  const list = document.getElementById('plugins')!;

  api<Page<Plugin>>('/api/plugins/')
    .then(({ results }) => {
      list.replaceChildren();
      if (!results.length) {
        list.append(el('div', 'empty', 'No plugins yet. Create one to get an API key.'));
        return;
      }
      for (const plugin of results) {
        const row = el('div', 'row');
        const info = el('div', 'grow');
        info.append(el('div', 'title', plugin.name), el('div', 'muted', plugin.desc || plugin.hint || 'No description'));
        row.append(info);
        if (plugin.prefix) row.append(el('span', 'mono muted', `${plugin.prefix}…`));
        list.append(row);
      }
    })
    .catch((err) => list.replaceChildren(el('div', 'empty', err.message)));
</script>
