---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Plugins">
  <div class="page-head">
    <div>
      <h1>Plugins</h1>
      <p class="muted">Schemas that Laya runs on each email you subscribe to.</p>
    </div>
    <a class="btn btn-primary" href="/plugins/new">New plugin</a>
  </div>
  <ul class="card list" id="plugins">
    <li class="empty">Loading…</li>
  </ul>
</Layout>

<script>
  import { api, el, type Page } from '../../lib/api';

  interface Plugin {
    id: string;
    name: string;
    desc: string;
    hint: string;
    prefix: string | null;
  }

  const list = document.getElementById('plugins')!;

  api<Page<Plugin>>('/api/plugins/')
    .then(({ results }) => {
      if (!results.length) {
        list.replaceChildren(el('li', 'empty', 'No plugins yet. Create one to get an API key.'));
        return;
      }
      list.replaceChildren(
        ...results.map((plugin) => {
          const row = el('li', 'row');
          const info = el('div', 'grow');
          const title = el('a', 'title mono', plugin.name);
          title.setAttribute('href', `/plugins/detail?id=${plugin.id}`);
          info.append(title, el('div', 'muted', plugin.desc || plugin.hint || 'No description'));
          row.append(info);
          if (plugin.prefix) row.append(el('span', 'mono muted', `${plugin.prefix}…`));
          return row;
        }),
      );
    })
    .catch((err) => list.replaceChildren(el('li', 'empty', err.message)));
</script>
