---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Plugins">
  <div class="page-head">
    <div>
      <div class="eyebrow">YOUR WORKSPACE <span class="live-dot"></span></div>
      <h1>Plugins</h1>
      <p class="muted">Small, focused agents that turn email into useful data.</p>
    </div>
    <a class="btn btn-primary" href="/plugins/new"><span>＋</span> Create plugin</a>
  </div>
  <ul class="card list plugin-list" id="plugins">
    <li class="empty">Loading…</li>
  </ul>
</Layout>

<script>
  import { el, listAll } from '../../lib/api';

  interface Plugin {
    id: string;
    name: string;
    desc: string;
    hint: string;
    prefix: string | null;
  }

  const list = document.getElementById('plugins')!;

  listAll<Plugin>('/api/plugins/')
    .then((plugins) => {
      if (!plugins.length) {
        list.replaceChildren(el('li', 'empty', 'No plugins yet. Create one to get an API key.'));
        return;
      }
      list.replaceChildren(
        ...plugins.map((plugin) => {
          const row = el('li', 'row');
          row.classList.add('plugin-row');
          const info = el('div', 'grow');
          const title = el('a', 'title mono', plugin.name);
          title.setAttribute('href', `/plugins/detail?id=${plugin.id}`);
          info.append(el('span', 'row-kicker', 'EMAIL AGENT'), title, el('div', 'muted', plugin.desc || plugin.hint || 'No description yet'));
          row.append(info);
          if (plugin.prefix) row.append(el('span', 'mono muted', `${plugin.prefix}…`));
          return row;
        }),
      );
    })
    .catch((err) => list.replaceChildren(el('li', 'empty', err.message)));
</script>
