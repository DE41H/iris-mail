---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="New plugin">
  <div class="page-head">
    <div>
      <h1>New plugin</h1>
      <p class="muted">Describe what Laya should pull from each email. You get an API key when it's created.</p>
    </div>
  </div>
  <form id="form" class="stack">
    <section class="card">
      <div class="card-body">
        <div class="grid-2">
          <div class="field">
            <label for="name">Name</label>
            <input id="name" name="name" class="mono" type="text" required pattern="[-a-z0-9_]+" autocomplete="off" spellcheck="false" aria-describedby="name-help" />
            <div id="name-help" class="help">Lowercase letters, numbers, - and _. Unique to you.</div>
          </div>
          <div class="field">
            <label for="desc">Description</label>
            <input id="desc" name="desc" type="text" />
          </div>
        </div>
        <div class="field">
          <label for="hint">Hint</label>
          <input id="hint" name="hint" type="text" />
          <div class="help">Helps Laya know what to look for in an email.</div>
        </div>
      </div>
    </section>

    <section class="card">
      <div class="card-head">Fields</div>
      <div class="card-body">
        <p class="muted">Each field is one question Laya answers per email. Pick a type, then define its answers.</p>
        <div id="builder"></div>
      </div>
    </section>

    <div id="error" class="alert alert-danger" role="alert" hidden></div>
    <div class="actions">
      <a class="btn" href="/plugins">Cancel</a>
      <button class="btn btn-primary" type="submit">Create plugin</button>
    </div>
  </form>
  <div id="result" hidden></div>
</Layout>

<script>
  import { api, ApiError, el } from '../../lib/api';
  import { mountBuilder } from '../../lib/builder';
  import { keyCard } from '../../lib/keycard';
  import { toSchema } from '../../lib/schema';

  const form = document.getElementById('form') as HTMLFormElement;
  const error = document.getElementById('error')!;
  const result = document.getElementById('result')!;
  const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
  const submit = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  const builder = mountBuilder(document.getElementById('builder')!, [], () => {
    if (!builder.problems().length) error.hidden = true;
  });

  const showError = (message: string) => {
    error.textContent = message;
    error.hidden = false;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    error.hidden = true;
    if (builder.problems().length) return showError('Fix the fields above before creating the plugin.');

    submit.disabled = true;
    submit.textContent = 'Creating…';
    try {
      const plugin = await api<{ id: string; key: string }>('/api/plugins/', {
        method: 'POST',
        body: JSON.stringify({
          name: field('name').value,
          desc: field('desc').value,
          hint: field('hint').value,
          schema: toSchema(builder.fields()),
        }),
      });
      const open = el('a', 'btn btn-sm', 'Open plugin');
      open.setAttribute('href', `/plugins/detail?id=${plugin.id}`);
      const all = el('a', 'btn btn-sm', 'All plugins');
      all.setAttribute('href', '/plugins');
      form.hidden = true;
      result.replaceChildren(keyCard(plugin.key, open, all));
      result.hidden = false;
    } catch (err) {
      showError(err instanceof ApiError ? err.message : 'Something went wrong.');
      submit.disabled = false;
      submit.textContent = 'Create plugin';
    }
  });
</script>
