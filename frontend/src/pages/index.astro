---
import Layout from '../layouts/Layout.astro';

const steps = [
  ['define', 'Write the questions', 'Pick a template or write your own: a choice, a yes/no or a scale. Iris turns them into a schema and gives you an API key.'],
  ['connect', 'Users opt in', 'A user signs in with Google and turns your plugin on. They see exactly what it does before anything is shared.'],
  ['fetch', 'Pull the answers', 'Every few minutes Iris checks for new mail, Laya answers your questions, and you fetch the results as JSON.'],
];

const promises = [
  ['email is never stored', 'Bodies and headers are read, answered, and dropped. Only the answers are kept.'],
  ['keys are hashed', 'API keys are kept as SHA-256 and shown to you exactly once. Rotate them any time.'],
  ['opt-in, per plugin', 'Every subscription starts off. Users can turn it on and off whenever they like.'],
  ['no double work', 'Each message is answered once per plugin. Duplicates are skipped before Laya runs.'],
];

const uses = ['receipts', 'shipping updates', 'support triage', 'job applications', 'travel bookings', 'invoices', 'newsletters', 'renewals'];
---

<Layout title="Email intelligence" wide>
  <section class="hero">
    <div class="copy">
      <div class="eyebrow reveal">email intelligence infrastructure</div>
      <h1 class="reveal" style="--i:1">Ask your users' inboxes a question.<br /><span class="green">Get JSON back.</span></h1>
      <p class="lead reveal" style="--i:2">
        Describe what you need from each email in plain language. Iris reads new mail, Laya answers your questions,
        and the email is thrown away. You only ever get the answer.
      </p>
      <div class="cta reveal" style="--i:3">
        <a class="btn btn-primary" href="/plugins/new">create a plugin →</a>
        <a class="btn" href="#how">how it works</a>
      </div>
    </div>

    <div class="term card reveal" style="--i:2" aria-label="Example: an email becomes structured data">
      <div class="term-head"><i></i><i></i><i></i><span>iris · live</span></div>
      <pre id="term" aria-hidden="true"></pre>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div>{[...uses, ...uses].map((u) => <span>{u}</span>)}</div>
  </div>

  <section id="how" class="section">
    <div class="eyebrow scroll-reveal">how it works</div>
    <h2 class="title scroll-reveal">Three steps. No email parsing.</h2>
    <ol class="steps">
      {steps.map(([tag, title, text], i) => (
        <li class="card scroll-reveal">
          <span class="step mono">0{i + 1} / {tag}</span>
          <h3>{title}</h3>
          <p class="muted">{text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section split">
    <div>
      <div class="eyebrow scroll-reveal">one request</div>
      <h2 class="title scroll-reveal">Results come back as JSON, ready to use.</h2>
      <p class="muted scroll-reveal">Ask for unread results with your plugin key. Each result is marked as fetched once you read it, so polling stays simple.</p>
    </div>
    <pre class="code card scroll-reveal"><span class="muted">$</span> curl -H <span class="s">"Authorization: Bearer $IRIS_KEY"</span> \
    /api/results/?fetched=false

<span class="muted">{'{'}</span>
  <span class="k">"results"</span>: [{'{'}
    <span class="k">"output"</span>: {'{'}
      <span class="k">"receipt"</span>: <span class="l">true</span>,
      <span class="k">"spend_category"</span>: <span class="s">"software"</span>,
      <span class="k">"urgency"</span>: <span class="n">1</span>
    {'}'},
    <span class="k">"fetched"</span>: <span class="l">false</span>
  {'}'}]
<span class="muted">{'}'}</span></pre>
  </section>

  <section class="section">
    <div class="eyebrow scroll-reveal">private by design</div>
    <h2 class="title scroll-reveal">Built so you never hold the mailbox.</h2>
    <div class="promises">
      {promises.map(([title, text]) => (
        <div class="card promise scroll-reveal">
          <h3><span class="green">✓</span> {title}</h3>
          <p class="muted">{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section final scroll-reveal">
    <h2 class="title">Write your first plugin in about a minute<span class="cursor"></span></h2>
    <div class="cta">
      <a class="btn btn-primary" href="/plugins/new">start building →</a>
      <a class="btn" href="/subscriptions">manage my inbox</a>
    </div>
  </section>
</Layout>

<script>
  const term = document.getElementById('term')!;
  const script: [string, string][] = [
    ['muted', '▸ new message  orders@shop.example'],
    ['', '  subject  Your receipt from Cloudly · $12.00'],
    ['muted', '▸ deduplicate  ok, not seen before'],
    ['muted', '▸ laya         answering 3 questions'],
    ['bar', ''],
    ['green', '✓ result'],
    ['', '{'],
    ['', '  "receipt": true,'],
    ['', '  "spend_category": "software",'],
    ['', '  "subscription": true'],
    ['', '}'],
    ['muted', '▸ email dropped. answer kept.'],
  ];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  async function typeLine(cls: string, text: string) {
    const line = document.createElement('div');
    line.className = cls;
    term.append(line);
    if (cls === 'bar') {
      for (let i = 0; i <= 20; i++) {
        line.textContent = `  [${'█'.repeat(i)}${'░'.repeat(20 - i)}] ${i * 5}%`;
        await wait(35);
      }
      return;
    }
    for (let i = 1; i <= text.length; i++) {
      line.textContent = text.slice(0, i);
      await wait(12);
    }
  }

  async function run() {
    while (term.isConnected) {
      term.replaceChildren();
      for (const [cls, text] of script) {
        await typeLine(cls, text);
        await wait(140);
      }
      if (reduced) return;
      await wait(3200);
    }
  }
  run();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
    min-height: calc(100vh - 220px);
    padding: 24px 0 48px;
  }
  .hero h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.04em; }
  .lead { margin-top: 20px; font-size: 16px; color: var(--muted); max-width: 52ch; }
  .cta { display: flex; gap: 10px; margin-top: 28px; flex-wrap: wrap; }
  .cta .btn { padding: 10px 18px; }

  .term { overflow: hidden; box-shadow: 0 0 80px rgba(61, 220, 132, 0.08), 0 30px 60px rgba(0, 0, 0, 0.5); }
  .term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--border); font: 11px var(--mono); color: var(--muted); }
  .term-head i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .term-head i:first-child { background: var(--green); }
  .term-head span { margin-left: auto; }
  #term { margin: 0; padding: 18px; min-height: 330px; font-size: 13px; line-height: 1.7; white-space: pre-wrap; }
  #term :global(.muted) { color: var(--muted); }
  #term :global(.green), #term :global(.bar) { color: var(--green); }
  #term :global(div:last-child)::after { content: '▌'; color: var(--green); animation: blink 1s steps(1) infinite; }

  .ticker { overflow: hidden; border-block: 1px solid var(--border); padding: 14px 0; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .ticker div { display: flex; gap: 48px; width: max-content; animation: marquee 32s linear infinite; }
  .ticker span { font: 13px var(--mono); color: var(--muted); white-space: nowrap; }
  .ticker span::before { content: '◆ '; color: var(--green); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .section { padding: 96px 0 0; }
  .title { font-size: clamp(22px, 3vw, 32px); letter-spacing: -0.03em; margin-bottom: 28px; max-width: 26ch; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { padding: 22px; display: grid; gap: 10px; transition: border-color 0.3s, transform 0.3s var(--ease); }
  .steps li:hover { border-color: var(--green); transform: translateY(-4px); }
  .step { font-size: 12px; color: var(--green); }
  h3 { font-size: 15px; }

  .split { display: grid; grid-template-columns: 1fr 1.2fr; gap: 48px; align-items: center; }
  .split .title { margin-bottom: 16px; }
  .code { margin: 0; padding: 20px; overflow: auto; font-size: 13px; line-height: 1.7; }
  .k { color: var(--green); }
  .s { color: #c9d8cf; }
  .n { color: var(--amber); }
  .l { color: #8ab4ff; }

  .promises { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .promise { padding: 22px; display: grid; gap: 8px; }

  .final { text-align: center; padding-bottom: 32px; }
  .final .title { margin: 0 auto; }
  .final .cta { justify-content: center; }

  @media (max-width: 860px) {
    .hero, .split { grid-template-columns: 1fr; min-height: 0; }
    .steps, .promises { grid-template-columns: 1fr; }
    .section { padding-top: 64px; }
  }
</style>
