---
import Layout from '../layouts/Layout.astro';
import Lens from '../components/Lens.svelte';
import Headline from '../components/Headline.svelte';

const steps = [
  ['Write your questions', 'Yes/no, a choice, a scale, a number, a date or short text. You get an API key.'],
  ['Send a connect link', 'People sign in with Google, see your questions and allow or deny.'],
  ['Fetch the answers', 'New mail is read every few minutes. Pull results as JSON.'],
];
---

<Layout title="Ask inboxes questions" wide>
  <div class="screen landing">
    <section class="hero">
      <Headline client:load />
      <p class="lead">An AI model reads each new email and answers your questions about it. You get the answers, never the email.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/plugins/new">Create a plugin</a>
        <a class="btn" href="/subscriptions">Manage my inbox</a>
      </div>
    </section>

    <div class="demo grow"><Lens client:only="svelte" /></div>

    <ol class="steps">
      {steps.map(([title, text]) => (
        <li>
          <b>{title}</b>
          <span>{text}</span>
        </li>
      ))}
    </ol>
  </div>
</Layout>

<style>
  /* Grows past one screen on short windows instead of running into the footer. */
  .landing { justify-content: space-between; gap: 28px; height: auto; min-height: calc(100dvh - 60px - 48px - 36px); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px 48px; align-items: end; }
  .lead, .cta { animation: rise 0.8s 0.5s var(--ease) both; }
  .lead { font-size: 17px; color: var(--muted); max-width: 40ch; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .cta .btn { padding: 11px 20px; font-size: 15px; }

  .demo { display: flex; flex-direction: column; justify-content: center; animation: rise 0.9s 0.7s var(--ease) both; }

  /* A real sequence, so it is numbered. */
  .steps { list-style: none; margin: 0; padding: 18px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; border-top: 1px solid var(--border); counter-reset: step; }
  .steps li { display: grid; gap: 2px; padding-left: 34px; position: relative; font-size: 14px; color: var(--muted); counter-increment: step; }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 12px;
    font-weight: 640;
  }
  .steps b { color: var(--text); font-weight: 600; }

  @media (max-width: 860px) {
    .hero, .steps { grid-template-columns: 1fr; }
    .steps { gap: 14px; }
    .cta .btn { flex: 1 1 auto; }
  }
</style>
