---
import Layout from '../layouts/Layout.astro';

const steps = [
  ['define', 'Write questions, get a key'],
  ['connect', 'Users opt in with Google'],
  ['fetch', 'Pull answers as JSON'],
];

const uses = ['receipts', 'shipping', 'support triage', 'job hunt', 'travel', 'invoices', 'newsletters', 'renewals'];
---

<Layout title="Email intelligence" wide>
  <div class="screen landing">
    <section class="hero grow">
      <div>
        <div class="eyebrow reveal">email intelligence</div>
        <h1 class="reveal d1">Ask inboxes questions.<br /><span class="green">Get JSON back.</span></h1>
        <p class="lead reveal d2">Laya answers every new email. You get the answers, never the email.</p>
        <div class="cta reveal d3">
          <a class="btn btn-primary" href="/plugins/new">create a plugin →</a>
          <a class="btn" href="/subscriptions">my inbox</a>
        </div>
      </div>

      <div class="term card reveal d2" aria-label="Example: an email becomes structured data">
        <div class="term-head"><i></i><i></i><i></i><span>iris · live</span></div>
        <pre id="term" aria-hidden="true"></pre>
      </div>
    </section>

    <ol class="steps">
      {steps.map(([tag, text], i) => (
        <li class="card reveal">
          <span class="green mono">0{i + 1} / {tag}</span>
          <span>{text}</span>
        </li>
      ))}
    </ol>

    <div class="ticker" aria-hidden="true">
      <div>{[...uses, ...uses].map((u) => <span>{u}</span>)}</div>
    </div>
  </div>
</Layout>

<script>
  const term = document.getElementById('term')!;
  const script: [string, string][] = [
    ['muted', '▸ new mail   orders@shop.example'],
    ['', '  subject    Your receipt · $12.00'],
    ['muted', '▸ laya       answering 3 questions'],
    ['bar', ''],
    ['green', '✓ result'],
    ['', '{'],
    ['', '  "receipt": true,'],
    ['', '  "spend_category": "software",'],
    ['', '  "subscription": true'],
    ['', '}'],
    ['muted', '▸ email dropped. answer kept.'],
  ];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait = (ms: number) => new Promise((r) => setTimeout(r, reduced ? 0 : ms));

  async function typeLine(cls: string, text: string) {
    const line = document.createElement('div');
    line.className = cls;
    term.append(line);
    if (cls === 'bar') {
      for (let i = 0; i <= 20; i++) {
        line.textContent = `  [${'█'.repeat(i)}${'░'.repeat(20 - i)}] ${i * 5}%`;
        await wait(35);
      }
      return;
    }
    for (let i = 1; i <= text.length; i++) {
      line.textContent = text.slice(0, i);
      await wait(12);
    }
  }

  async function run() {
    while (term.isConnected) {
      term.replaceChildren();
      for (const [cls, text] of script) {
        await typeLine(cls, text);
        await wait(140);
      }
      if (reduced) return;
      await wait(3200);
    }
  }
  run();
</script>

<style>
  .landing { justify-content: center; }
  .hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .hero h1 { font-size: clamp(30px, 4.6vw, 52px); line-height: 1.08; letter-spacing: -0.04em; }
  .lead { margin-top: 16px; font-size: 16px; color: var(--muted); max-width: 42ch; }
  .cta { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
  .cta .btn { padding: 10px 18px; }

  .term { overflow: hidden; box-shadow: 0 0 80px rgba(61, 220, 132, 0.08), 0 30px 60px rgba(0, 0, 0, 0.5); }
  .term-head { display: flex; align-items: center; gap: 6px; padding: 10px 14px; border-bottom: 1px solid var(--border); font: 11px var(--mono); color: var(--muted); }
  .term-head i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .term-head i:first-child { background: var(--green); }
  .term-head span { margin-left: auto; }
  #term { margin: 0; padding: 16px 18px; height: 290px; font-size: 13px; line-height: 1.7; white-space: pre-wrap; }
  #term :global(.muted) { color: var(--muted); }
  #term :global(.green), #term :global(.bar) { color: var(--green); }
  #term :global(div:last-child)::after { content: '▌'; color: var(--green); animation: blink 1s steps(1) infinite; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .steps li { display: grid; gap: 2px; padding: 14px 16px; font-size: 13px; transition: border-color 0.3s, transform 0.3s var(--ease); }
  .steps li:hover { border-color: var(--green); transform: translateY(-3px); }
  .steps .mono { font-size: 11px; }
  .steps li:nth-child(1) { --i: 4; }
  .steps li:nth-child(2) { --i: 5; }
  .steps li:nth-child(3) { --i: 6; }

  .ticker { overflow: hidden; border-block: 1px solid var(--border); padding: 10px 0; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .ticker div { display: flex; gap: 48px; width: max-content; animation: marquee 32s linear infinite; }
  .ticker span { font: 12px var(--mono); color: var(--muted); white-space: nowrap; }
  .ticker span::before { content: '◆ '; color: var(--green); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 860px) {
    .hero, .steps { grid-template-columns: 1fr; }
  }
</style>
