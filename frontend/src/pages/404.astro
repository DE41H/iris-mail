---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found">
  <div class="screen">
    <div class="page-head reveal">
      <div>
        <div class="eyebrow">Error 404</div>
        <h1>Nothing here</h1>
        <p>The link may be old, or the page moved.</p>
      </div>
    </div>
    <div><a class="btn" href="/">Go home</a></div>
  </div>
</Layout>
