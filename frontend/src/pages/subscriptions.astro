---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Subscriptions">
  <div class="page-head">
    <div>
      <div class="eyebrow">YOUR INBOX, ON YOUR TERMS <span class="live-dot"></span></div>
      <h1>Subscriptions</h1>
      <p class="muted">Choose the signals you want your inbox to notice.</p>
    </div>
  </div>
  <ul class="card list subscription-list" id="subscriptions">
    <li class="empty">Loading…</li>
  </ul>
</Layout>

<script>
  import { api, el, listAll } from '../lib/api';

  interface Subscription {
    id: string;
    plugin: string;
    plugin_name: string;
    plugin_desc: string;
    active: boolean;
  }

  const list = document.getElementById('subscriptions')!;

  // Turning a plugin on shares extracted data with its creator, so it asks first, inline.
  // Turning one off takes effect right away.
  const render = (sub: Subscription): HTMLElement => {
    const item = el('li', 'row sub');
    item.classList.add('subscription-row');
    const info = el('div', 'grow');
    info.append(el('span', 'row-kicker', 'SIGNAL SOURCE'), el('div', 'title mono', sub.plugin_name), el('div', 'muted', sub.plugin_desc || 'No description'));

    const label = el('label', 'switch');
    const box = document.createElement('input');
    box.type = 'checkbox';
    box.setAttribute('role', 'switch');
    box.checked = sub.active;
    const track = el('span', 'track');
    track.setAttribute('aria-hidden', 'true');
    label.append(box, track, el('span', 'switch-text', sub.active ? 'On' : 'Off'));

    const status = el('div', 'sub-status');
    item.append(info, label, status);

    // Sends the state the user chose, not a flip, so a stale tab cannot turn sharing on or off by mistake.
    const flip = async (active: boolean) => {
      status.replaceChildren();
      item.setAttribute('aria-busy', 'true');
      box.disabled = true;
      try {
        const updated = await api<Subscription>(`/api/subscriptions/${sub.id}/set_active/`, {
          method: 'POST',
          body: JSON.stringify({ active }),
        });
        item.replaceWith(render(updated));
      } catch (err) {
        box.checked = sub.active;
        box.disabled = false;
        item.removeAttribute('aria-busy');
        status.replaceChildren(el('div', 'alert alert-danger', err instanceof Error ? err.message : 'Something went wrong.'));
      }
    };

    const askConsent = () => {
      box.checked = false;
      const yes = el('button', 'btn btn-primary btn-sm', 'Enable');
      yes.type = 'button';
      yes.addEventListener('click', () => flip(true));
      const no = el('button', 'btn btn-sm', 'Cancel');
      no.type = 'button';
      no.addEventListener('click', () => status.replaceChildren());
      const panel = el('div', 'consent');
      panel.append(
        el('p', '', `Enabling ${sub.plugin_name} shares what Laya extracts from your emails with its creator. Raw emails are never shared.`),
        el('div', 'actions', ''),
      );
      panel.lastElementChild!.append(no, yes);
      status.replaceChildren(panel);
      yes.focus();
    };

    box.addEventListener('change', () => (box.checked ? askConsent() : flip(false)));
    return item;
  };

  listAll<Subscription>('/api/subscriptions/')
    .then((subscriptions) => {
      if (!subscriptions.length) {
        list.replaceChildren(el('li', 'empty', 'No subscriptions yet. Plugins that a developer adds to your account appear here.'));
        return;
      }
      list.replaceChildren(...subscriptions.map(render));
    })
    .catch((err) => list.replaceChildren(el('li', 'empty', err.message)));
</script>
