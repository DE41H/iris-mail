---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Subscriptions">
  <div class="page-head">
    <h1>Subscriptions</h1>
  </div>
  <div class="box" id="subscriptions"><div class="empty">Loading…</div></div>
</Layout>

<script>
  import { api, el, type Page } from '../lib/api';

  interface Subscription {
    id: string;
    plugin: string;
    active: boolean;
  }

  const list = document.getElementById('subscriptions')!;

  const render = (sub: Subscription) => {
    const row = el('div', 'row');
    row.dataset.id = sub.id;
    const info = el('div', 'grow');
    info.append(el('div', 'title mono', sub.plugin));
    const toggle = el('button', 'btn btn-sm', sub.active ? 'Disable' : 'Enable');
    toggle.type = 'button';
    row.append(info, el('span', sub.active ? 'label label-on' : 'label', sub.active ? 'Active' : 'Inactive'), toggle);
    toggle.addEventListener('click', async () => {
      toggle.disabled = true;
      const updated = await api<Subscription>(`/api/subscriptions/${sub.id}/toggle/`, { method: 'POST' });
      row.replaceWith(render(updated));
    });
    return row;
  };

  api<Page<Subscription>>('/api/subscriptions/')
    .then(({ results }) => {
      list.replaceChildren();
      if (!results.length) {
        list.append(el('div', 'empty', 'No subscriptions. Plugins you enable will appear here.'));
        return;
      }
      list.append(...results.map(render));
    })
    .catch((err) => list.replaceChildren(el('div', 'empty', err.message)));
</script>
