---
import Layout from '../layouts/Layout.astro';
import SubscriptionList from '../components/SubscriptionList.svelte';
import DeleteAccount from '../components/DeleteAccount.svelte';
---

<Layout title="Subscriptions">
  <div class="screen">
    <div class="page-head reveal">
      <div>
        <div class="eyebrow">subscriptions</div>
        <h1>What reads your inbox<span class="cursor"></span></h1>
        <p>Only answers are shared, never emails.</p>
      </div>
      <DeleteAccount client:only="svelte" />
    </div>
    <SubscriptionList client:only="svelte" />
  </div>
</Layout>
