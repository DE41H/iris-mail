---
import Layout from '../layouts/Layout.astro';
import ApiDocs from '../components/ApiDocs.svelte';
---

<Layout title="API docs" wide>
  <div class="screen">
    <div class="page-head reveal">
      <div>
        <div class="eyebrow">docs</div>
        <h1>The Iris API<span class="cursor"></span></h1>
        <p>Generated from the backend. Raw OpenAPI at <a href="/api/schema/?format=json">/api/schema/</a>.</p>
      </div>
    </div>
    <ApiDocs client:only="svelte" />
  </div>
</Layout>
