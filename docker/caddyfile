(site_headers) {
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

{$SITE_ADDRESS} {
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	@django path /api/* /accounts/* /admin/* /signup/*
	handle @django {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		import site_headers
		file_server
	}

	handle_errors 404 {
		root * /srv
		import site_headers
		rewrite * /404.html
		file_server
	}
}
