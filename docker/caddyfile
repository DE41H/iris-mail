(site_headers) {
	header {
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age={$DJANGO_HSTS_SECONDS:3600}"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}
}

{$SITE_ADDRESS} {
	handle_path /static/* {
		root * /srv/static
		import site_headers
		header ?Cache-Control "public, max-age=600"
		header /fonts/* Cache-Control "public, max-age=31536000"
		encode zstd gzip
		file_server
	}

	@django path /api/* /accounts/* /admin/* /signup/*
	handle @django {
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 1s
			}
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 2s
			transport http {
				dial_timeout 1s
			}
		}
	}

	handle {
		root * /srv/site
		import site_headers
		header ?Cache-Control "public, max-age=600"
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		header Speculation-Rules "\"/speculation-rules.json\""
		header /speculation-rules.json Content-Type application/speculationrules+json
		try_files {path} {path}/index.html
		encode zstd gzip
		file_server
	}

	handle_errors 404 {
		root * /srv/site
		import site_headers
		rewrite * /404.html
		file_server
	}
}
