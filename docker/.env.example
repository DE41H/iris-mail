# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://iris.example.com
# Set to True when Caddy (or another proxy) terminates TLS in front of Django.
DJANGO_BEHIND_PROXY=True

# PostgreSQL
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Valkey (cache)
VALKEY_URL=redis://valkey:6379/1

# Google OAuth (allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Caddy: the public domain it serves and gets a certificate for.
SITE_ADDRESS=localhost

# Google Pub/Sub (Gmail push). Topic is the full name, e.g. projects/my-gcp-project/topics/gmail-inbox.
GMAIL_PUBSUB_TOPIC=
PUBSUB_PUSH_TOKEN=change-me-to-a-long-random-string
