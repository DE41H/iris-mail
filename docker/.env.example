# Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://iris.example.com
# Set to True when Caddy (or another proxy) terminates TLS in front of Django.
DJANGO_BEHIND_PROXY=True
DJANGO_HSTS_SECONDS=3600

# PostgreSQL
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Valkey (cache)
VALKEY_URL=redis://valkey:6379/1
CACHEOPS_URL=redis://valkey:6379/2

# Google OAuth (allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# With DJANGO_SECRET_KEY, encrypts stored Google tokens. Changing either one means every user must sign in again.
DJANGO_SALT_KEY=change-me-to-a-long-random-string

# LLM API keys, comma separated (key1,key2).
ANTHROPIC_KEYS=
GEMINI_KEYS=

# Caddy: the public domain it serves and gets a certificate for.
SITE_ADDRESS=localhost

# Admin: `manage.py mk_admin` makes this superuser.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
